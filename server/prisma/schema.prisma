generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  USER
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  passwordHash     String
  name             String?
  /// Utilizador autorizou envio de agregados a um LLM externo (Case).
  caseLlmOptIn     Boolean              @default(false)
  role             UserRole             @default(USER)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  passwordResets   PasswordResetToken[]
  workspacesOwned  Workspace[]          @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  pagesCreated     Page[]               @relation("PageCreator")
  pointsEvents     PointsEvent[]
  gameProfile      UserGameProfile?
  gameAchievements UserAchievement[]
  gameActivities   GameActivityLog[]
  activityEvents   ActivityEvent[]
  userAttributes   UserAttribute[]
  dailyMissions    DailyMissionProgress[]
  prestigeResets   PrestigeReset[]
  shopItems        UserShopItem[]
  financialProfile FinancialProfile?
  financeAccounts  FinanceAccount[]
  financeMovements       FinanceMovement[]
  financeMovementRollups FinanceMovementRollup[]
  financeReviews        FinanceWeeklyReview[]
  financeMethodProgress UserMethodProgress[]
  financeCategoryBudgets FinanceCategoryBudget[]
  financeAccountGoals   FinanceAccountGoal[]
  caseConversations     CaseConversation[]
}

model CaseConversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String        @default("finance")
  title     String?
  messages  CaseMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt])
}

model CaseMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   CaseConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  source         String           @default("user")
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Workspace ────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String
  icon        String?
  description String?
  ownerId     String
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  pages       Page[]
  databases   Database[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([ownerId, slug])
  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ─── Pages & Blocks ─────────────────────────────────────────────────────────

model Page {
  id          String   @id @default(cuid())
  workspaceId String
  parentId    String?
  title       String   @default("Sem título")
  icon        String?
  sortOrder   Int      @default(0)
  isArchived  Boolean  @default(false)
  createdById String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      Page?    @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Page[]   @relation("PageTree")
  creator     User     @relation("PageCreator", fields: [createdById], references: [id])
  blocks      Block[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([parentId])
}

enum BlockType {
  PARAGRAPH
  HEADING_1
  HEADING_2
  HEADING_3
  CHECKLIST
  TODO
  QUOTE
  CALLOUT
  CODE
  IMAGE
  DIVIDER
  TOGGLE
  DATABASE_EMBED
  KANBAN_EMBED
  CALENDAR_EMBED
}

model Block {
  id        String    @id @default(cuid())
  pageId    String
  parentId  String?
  type      BlockType @default(PARAGRAPH)
  content   Json      @default("{}")
  sortOrder Int       @default(0)
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parent    Block?    @relation("BlockTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Block[]   @relation("BlockTree")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([pageId])
  @@index([parentId])
}

// ─── Database engine ────────────────────────────────────────────────────────

enum DatabaseTemplate {
  CUSTOM
  TASKS
  HABITS
  GOALS
  STUDIES
  NOTES
  PROJECTS
  CLIENTS
}

enum DatabasePropertyType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  STATUS
  CHECKBOX
  RELATION
  DATE
  EMAIL
  URL
  FORMULA
}

enum DatabaseViewType {
  TABLE
  BOARD
  CALENDAR
  LIST
}

model Database {
  id          String             @id @default(cuid())
  workspaceId String
  name        String
  icon        String?
  template    DatabaseTemplate   @default(CUSTOM)
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  properties  DatabaseProperty[]
  views       DatabaseView[]
  rows        DatabaseRow[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([workspaceId])
}

model DatabaseProperty {
  id         String               @id @default(cuid())
  databaseId String
  name       String
  type       DatabasePropertyType
  config     Json                 @default("{}")
  sortOrder  Int                  @default(0)
  database   Database             @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@unique([databaseId, name])
  @@index([databaseId])
}

model DatabaseView {
  id         String           @id @default(cuid())
  databaseId String
  name       String
  type       DatabaseViewType @default(TABLE)
  config     Json             @default("{}")
  sortOrder  Int              @default(0)
  database   Database         @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([databaseId])
}

model DatabaseRow {
  id         String   @id @default(cuid())
  databaseId String
  properties Json     @default("{}")
  sortOrder  Int      @default(0)
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  pointsEvents PointsEvent[]
  activityEvents ActivityEvent[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([databaseId])
}

// ─── Gamificação (XP + streaks) ─────────────────────────────────────────────

enum PointsEventSource {
  TASK
  HABIT
  GOAL
  STUDY
  CLIENT
}

model PointsEvent {
  id          String            @id @default(cuid())
  userId      String
  workspaceId String
  rowId       String
  source      PointsEventSource
  date        DateTime          @db.Date
  points      Int
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  row         DatabaseRow       @relation(fields: [rowId], references: [id], onDelete: Cascade)

  @@unique([rowId, date])
  @@index([userId, date])
  @@index([workspaceId, date])
}

// ─── Game Mode (camada opcional de gamificação) ─────────────────────────────

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum AchievementCategory {
  STREAK
  TASKS
  STUDY
  GOALS
  CONSISTENCY
  DEEP_WORK
  LEVEL
  PRESTIGE
}

enum GamePhase {
  AWAKENING
  MOMENTUM
  EXECUTION
  MASTERY
  EVOLUTION
  TRANSCENDENCE
  GOD_MODE
}

enum ActivityEventType {
  TASK_COMPLETED
  HABIT_COMPLETED
  STUDY_SESSION_COMPLETED
  GOAL_COMPLETED
  CLIENT_CLOSED
  WEEK_PERFECT
  STREAK_UPDATED
  LEVEL_UP
  ATTRIBUTE_INCREASED
  ACHIEVEMENT_UNLOCKED
  MISSION_COMPLETED
  PRESTIGE_RESET
  FINANCE_METHOD_STEP
  FINANCE_REVIEW_COMPLETED
  FINANCE_GOAL_REACHED
  FINANCE_BUDGET_RESPECTED
  FINANCE_REVIEW_STREAK
  FINANCE_METHOD_COMPLETED
}

enum MissionPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

model UserGameProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  gameModeEnabled  Boolean  @default(false)
  totalXp          Int      @default(0)
  lifetimeXp       Int      @default(0)
  level            Int      @default(1)
  rankTitle        String   @default("Wanderer")
  phase            GamePhase @default(AWAKENING)
  prestigeLevel    Int      @default(0)
  ascensionCount   Int      @default(0)
  avatarIcon       String   @default("user")
  currentStreak    Int      @default(0)
  tasksCompleted   Int      @default(0)
  habitsCompleted  Int      @default(0)
  studyMinutes     Int      @default(0)
  goalsCompleted   Int      @default(0)
  activeDays       Int      @default(0)
  deepWorkDays     Int      @default(0)
  perfectWeeks     Int      @default(0)
  lifeCoins        Int      @default(0)
  lifetimeCoins    Int      @default(0)
  displayTitle     String?
  lastActiveDate   DateTime? @db.Date
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ShopItemType {
  TITLE
  AVATAR
}

model ShopItemDefinition {
  id                    String            @id
  type                  ShopItemType
  label                 String
  description           String
  icon                  String
  price                 Int
  rarity                AchievementRarity @default(COMMON)
  payload               String
  minLevel              Int               @default(1)
  minPrestige           Int               @default(0)
  requiresAchievementId String?
  sortOrder             Int               @default(0)
  purchases             UserShopItem[]
}

model UserShopItem {
  id          String             @id @default(cuid())
  userId      String
  itemId      String
  purchasedAt DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  item        ShopItemDefinition @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
}

model AchievementDefinition {
  id          String            @id
  name        String
  description String
  icon        String
  rarity      AchievementRarity @default(COMMON)
  category    AchievementCategory @default(CONSISTENCY)
  xpReward    Int               @default(0)
  criteriaKey String
  criteriaValue Int             @default(1)
  sortOrder   Int               @default(0)
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String                @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model UserAttribute {
  id     String @id @default(cuid())
  userId String
  key    String
  value  Float  @default(0)
  lastDelta Float @default(0)
  updatedAt DateTime @updatedAt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model GameActivityLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  xpDelta   Int      @default(0)
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ActivityEvent {
  id         String            @id @default(cuid())
  userId     String
  workspaceId String
  rowId      String?
  type       ActivityEventType
  source     PointsEventSource?
  eventDate  DateTime          @db.Date
  xpDelta    Int               @default(0)
  payload    Json              @default("{}")
  dedupeKey  String?           @unique
  createdAt  DateTime          @default(now())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  row        DatabaseRow?      @relation(fields: [rowId], references: [id], onDelete: Cascade)

  @@index([userId, eventDate])
  @@index([workspaceId, eventDate])
  @@index([type, createdAt])
}

model DailyMissionProgress {
  id         String        @id @default(cuid())
  userId     String
  missionKey String
  period     MissionPeriod @default(DAILY)
  date       DateTime      @db.Date
  progress   Int           @default(0)
  target     Int
  completed  Boolean       @default(false)
  xpReward   Int
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionKey, date, period])
  @@index([userId, date])
  @@index([userId, period, date])
}

model PrestigeReset {
  id               String   @id @default(cuid())
  userId           String
  prestigeLevel    Int
  previousLevel    Int
  previousXp       Int
  lifetimeXp       Int
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── Modo Finanças (F1.0) ───────────────────────────────────────────────────

enum FinanceAccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT_CARD
  INVESTMENT
  LOAN
  OTHER
}

enum FinanceMovementType {
  EXPENSE
  INCOME
  TRANSFER
  ADJUSTMENT
}

enum FinanceCategoryKind {
  EXPENSE
  INCOME
}

model FinancialProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency                String   @default("AOA")
  activeMethodId          String?
  methodStepIndex         Int      @default(0)
  onboardingDone            Boolean   @default(false)
  questionnaireCompletedAt  DateTime?
  onboardingAnswers         Json      @default("{}")
  defaultExpenseAccountId   String?
  defaultIncomeAccountId    String?
  defaultSavingsAccountId   String?
  /// % da receita a transferir para poupança (método «paga-te a ti primeiro»).
  payYourselfPercent        Decimal?  @db.Decimal(5, 2)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model FinanceAccount {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  type               FinanceAccountType
  currency           String             @default("AOA")
  icon               String?
  color              String?
  initialBalance     Decimal            @default(0) @db.Decimal(14, 2)
  initialBalanceDate DateTime           @default(now()) @db.Date
  institution        String?
  maskedIdentifier   String?
  includeInNetWorth  Boolean            @default(true)
  isArchived         Boolean            @default(false)
  sortOrder          Int                @default(0)
  /// Cartão: limite de crédito (opcional).
  creditLimit        Decimal?           @db.Decimal(14, 2)
  /// Cartão: dia de fecho do ciclo (1–28).
  billingCycleDay    Int?
  /// Cartão: dia limite de pagamento (1–28).
  paymentDueDay      Int?
  /// TAEG/juro anual % (cartão ou empréstimo).
  aprPercent         Decimal?           @db.Decimal(6, 3)
  /// Empréstimo: prestação mínima mensal.
  minimumPayment     Decimal?           @db.Decimal(14, 2)
  /// Empréstimo: capital inicial contratado.
  originalPrincipal  Decimal?           @db.Decimal(14, 2)
  movements          FinanceMovement[]    @relation("MovementAccount")
  transfersIn        FinanceMovement[]    @relation("TransferDestAccount")
  goals              FinanceAccountGoal[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([userId])
}

model FinanceCategory {
  id        String              @id
  kind      FinanceCategoryKind
  name      String
  icon      String?
  sortOrder Int                 @default(0)
  movements FinanceMovement[]
  budgets   FinanceCategoryBudget[]

  @@index([kind])
}

model FinanceCategoryBudget {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       DateTime        @db.Date
  categoryId  String
  category    FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  limitAmount Decimal         @db.Decimal(14, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([userId, month, categoryId])
  @@index([userId, month])
}

model FinanceAccountGoal {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  targetAmount    Decimal        @db.Decimal(14, 2)
  targetAccountId String
  targetAccount   FinanceAccount @relation(fields: [targetAccountId], references: [id], onDelete: Cascade)
  deadline        DateTime?      @db.Date
  status          String         @default("ACTIVE")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([targetAccountId])
}

model FinanceMovement {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  FinanceMovementType
  accountId             String
  account               FinanceAccount      @relation("MovementAccount", fields: [accountId], references: [id], onDelete: Cascade)
  transferDestAccountId String?
  transferDestAccount   FinanceAccount?     @relation("TransferDestAccount", fields: [transferDestAccountId], references: [id], onDelete: SetNull)
  amount                Decimal             @db.Decimal(14, 2)
  date                  DateTime            @db.Date
  categoryId            String?
  category              FinanceCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  note                  String?
  linkedClientRowId     String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId, date])
  @@index([accountId])
}

/// Lote compactado: 25 movimentos em detalhe → 1 resumo (id fin-roll-*), linhas preservam saldos.
model FinanceMovementRollup {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sequence   Int
  periodFrom DateTime @db.Date
  periodTo   DateTime @db.Date
  count      Int      @default(25)
  totals     Json
  lines      Json
  createdAt  DateTime @default(now())

  @@unique([userId, sequence])
  @@index([userId])
}

model FinanceWeeklyReview {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart        DateTime @db.Date
  answers          Json     @default("{}")
  accountSnapshots Json     @default("{}")
  createdAt        DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([userId])
}

model UserMethodProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  methodId    String
  stepIndex   Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, methodId])
  @@index([userId])
}
