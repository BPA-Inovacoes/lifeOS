DATABASE_URL="postgresql://USER:PASSWORD@ep-exemplo-pooler.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Neon: URL directa (sem -pooler) para migrações Prisma — copiar do painel Neon
DIRECT_URL="postgresql://USER:PASSWORD@ep-exemplo.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="defina_um_segredo_com_pelo_menos_16_caracteres"
JWT_EXPIRES_IN="7d"
PORT="3333"
CLIENT_ORIGIN="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081"
LOG_LEVEL="debug"
# "false" omite linhas de exemplo e histórico XP demo no prisma db seed
SEED_DEMO="true"

# Case — LLM externo (opcional; sem chave = motor local, 100% no teu servidor)
# Groq: https://console.groq.com/keys — não usa os dados para treinar modelos (API Terms)
CASE_LLM_PROVIDER="groq"
CASE_LLM_API_KEY=""
CASE_LLM_MODEL="gpt-4o-mini"
CASE_LLM_BASE_URL="https://api.openai.com/v1"
